# -- Database (Supabase Postgres, or local docker-compose Postgres) --
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/showup

# -- Supabase --
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for older projects that sign with a shared secret (HS256). Leave empty to use JWKS.
# For LOCAL DEV WITHOUT SUPABASE: leave SUPABASE_URL empty and set this to any long random string;
# that (plus DEMO_MODE=true) enables the local-only /auth/dev-login.
SUPABASE_JWT_SECRET=

# -- WhatsApp Cloud API (Phase 7) --
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_API_VERSION=v21.0

# -- Razorpay booking deposits (optional; Phase 8). Use rzp_test_ keys until you are ready to take real money. --
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -- App --
# true only for demos/local dev. MUST be false in production (enables the Simulator and the demo controls, incl. Reset demo).
DEMO_MODE=true
INTERNAL_TICK_SECRET=change-me
PUBLIC_BOOKING_ALLOWED_ORIGINS=http://localhost:3100
APP_TIMEZONE=Asia/Kolkata
# Reverse proxies in front of the API whose X-Forwarded-For entry we trust (0 = use the socket address).
# Needed for the public booking rate limit to see real visitors when hosted behind a proxy.
TRUSTED_PROXY_HOPS=0
# The API's public address, shown in Settings as the webhook URL to give Meta.
PUBLIC_API_URL=
# Web app only: sites allowed to frame /book/embed (space-separated). Empty = any site.
NEXT_PUBLIC_EMBED_ORIGINS=
# Set false to run without the in-process 30s scheduler (then drive POST /internal/tick from cron)
SCHEDULER_ENABLED=true

# -- Demo staff passwords (seeded users; fictional clinic) --
DEMO_OWNER_PASSWORD=ShowUp-Owner-2026
DEMO_RECEPTION_PASSWORD=ShowUp-Reception-2026
